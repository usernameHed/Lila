{
  "name": "lila-player-journeys",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": ".venv/bin/python pipeline/build.py",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && vitest run",
    "test": "vitest",
    "preview": "vite build && wrangler dev",
    "deploy": "vite build && XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config/wrangler-ugo} wrangler deploy"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7",
    "wrangler": "^4.164.0"
  }
}
